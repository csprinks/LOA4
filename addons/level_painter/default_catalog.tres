[sub_resource type="Resource" id="Resource_ytfht"]
script = ExtResource("2_mbpkg")
name_id = &"lever"
kind = 2
display_name = "Lever"
color = Color(0.8, 0.8, 0.85, 1)
scene_path = "res://Lever/Lever.tscn"
y_offset = 1.0
facing_offset = 180
params = Array[Dictionary]([{
"default": 0,
"label": "In a puzzle, must be",
"name": "puzzle_required_state",
"options": ["Up (pulled)", "Down (left alone)"],
"painter_only": true,
"type": "enum"
}])
link_rules = Array[Dictionary]([{
"many": true,
"property": "connected_doors",
"target": "edge:3"
}, {
"many": true,
"property": "connected_platforms",
"target": "obj:moving_platform",
"target_set": {
"activation_type": 1
}
}, {
"target": "obj:puzzle",
"target_append": "levers",
"target_append_value": {
"default": 0,
"param": "puzzle_required_state",
"property": "required_states"
}
}])
wall_mounted = true

