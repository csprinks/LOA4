# Godot 4+ specific ignores
.godot/
.nomedia
/android/

# Medieval Village: Godot re-extracts embedded glTF textures next to each .glb on
# import (gltf/embedded_image_handling=Extract). These are derived from the
# self-contained .glb source and regenerate on import, so keep them out of the repo.
/Assets/MedievalVillage/Meshes/*.png
/Assets/MedievalVillage/Meshes/*.png.import
/Assets/MedievalVillage/Meshes/*.webp
/Assets/MedievalVillage/Meshes/*.webp.import

# Godot-specific ignores
.import/
export.cfg
export_credentials.cfg
*.tmp

# Imported translations (automatically generated from CSV files)
*.translation

# .NET / Mono build artifacts
.mono/
data_*/
mono_crash.*.json
bin/
obj/

# IDE
.idea/
.vs/

# Backup files (e.g. csproj snapshots)
*.old
*.old.*
